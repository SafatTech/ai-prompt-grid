NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional for Phase 3+: leave empty to use static catalog seed fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Creators section robot (how-it-works). Published Spline scene URL ending in .splinecode.
# Leave empty to show the static companion fallback. Enable mouse-follow in Spline before publishing.
# Example: NEXT_PUBLIC_SPLINE_CREATORS_SCENE=https://prod.spline.design/xxxxxxxx/scene.splinecode
NEXT_PUBLIC_SPLINE_CREATORS_SCENE=

# Server-only. Required for npm run db:seed. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

SENTRY_DSN=

# Google Analytics 4 measurement ID (public, starts with G-).
# Leave empty to render nothing and load no analytics script.
# In Vercel: Project → Settings → Environment Variables → add
# NEXT_PUBLIC_GA_MEASUREMENT_ID for the Production environment, then redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
